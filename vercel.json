{
  "version": 2,
  "builds": [
    { "src": "public/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin", "dest": "/public/admin.html" },
    { "src": "/api/(.*)", "dest": "https://nesara-qfs-lab-production.up.railway.app/api/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
